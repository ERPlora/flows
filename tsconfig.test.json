{
  // The TEST typecheck: everything `tsconfig.json` compiles, PLUS the `ui/**/*.test.ts` it leaves
  // out — and Node's globals, which those files genuinely need (`node:fs`, `node:path`,
  // `node:child_process`, `__dirname`). A test that reads the repository from disk is a Node
  // program; the component it exercises is not, and that is why they are two files.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["ui/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
